# Gemini AI API Configuration (Optional: Enables automated ANPR numberplate extraction & invoice OCR)
GEMINI_API_KEY=""

# Application Host URL (e.g. http://localhost:3000 or your production domain)
APP_URL="http://localhost:3000"

# Notification Email Dispatch (Optional: SMTP Server settings for job intake alerts)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="alerts@example.com"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM="FleetTrack Alerts <alerts@example.com>"
NOTIFICATION_EMAIL="fleet-manager@example.com"
